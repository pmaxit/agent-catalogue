# Cursor Cloud Agents API key — https://cursor.com/dashboard/integrations
CURSOR_API_KEY=

# Optional overrides (also configurable in config/agents.yaml)
# CURSOR_API_BASE_URL=https://api.cursor.com
# CURSOR_MODEL=composer-2.5
# CURSOR_MOCK=false
PORT=8080

# SQLite persistence (local default: ./data/quill.db)
# On Railway, prefer a volume at /data and SQLITE_PATH=/data/quill.db
# SQLITE_PATH=/data/quill.db
