# Cursor Cloud Agents API key — https://cursor.com/dashboard/integrations
CURSOR_API_KEY=

# Optional overrides (also configurable in config/agents.yaml)
# CURSOR_API_BASE_URL=https://api.cursor.com
# CURSOR_MODEL=composer-2.5
# CURSOR_MOCK=false
PORT=8080

# SQLite persistence — Railway volume only (never ./data/quill.db locally)
# On Railway: SQLITE_PATH=/data/quill.db (set in Dockerfile)
# Local studio saves books/chapters/articles to the Railway app API instead.
# QUILL_DATA_API_BASE=https://writing-agent-production-b61f.up.railway.app
